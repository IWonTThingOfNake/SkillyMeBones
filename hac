local function Notify(message, duration)
	duration = duration or 3

	local notification = Instance.new("Frame")
	notification.Size = UDim2.new(1, 0, 0, 50)
	notification.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	notification.BackgroundTransparency = 1
	notification.BorderSizePixel = 0
	notification.Parent = container

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = notification

	local text = Instance.new("TextLabel")
	text.Size = UDim2.new(1, -20, 1, 0)
	text.Position = UDim2.new(0, 10, 0, 0)
	text.BackgroundTransparency = 1
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextTransparency = 1
	text.TextScaled = true
	text.Font = Enum.Font.GothamBold
	text.Text = message
	text.Parent = notification
	
	local fadeIn = TweenService:Create(notification, TweenInfo.new(0.3), {
		BackgroundTransparency = 0
	})
	
	local textFadeIn = TweenService:Create(text, TweenInfo.new(0.3), {
		TextTransparency = 0
	})
	
	fadeIn:Play()
	textFadeIn:Play()

	task.wait(duration)

	local fadeOut = TweenService:Create(notification, TweenInfo.new(0.3), {
		BackgroundTransparency = 1
	})
	
	local textFadeOut = TweenService:Create(text, TweenInfo.new(0.3), {
		TextTransparency = 1
	})
	
	fadeOut:Play()
	textFadeOut:Play()
	
	fadeOut.Completed:Wait()
	notification:Destroy()
end

